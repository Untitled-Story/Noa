// NOMS 2.0 (beta). Unity local coordinates, original triangle winding.
namespace Noa.Mesh;
struct Vec3 { x:float; y:float; z:float; }
struct Vec4 { x:float; y:float; z:float; w:float; }
table TexCoord {
  channel:ubyte; dimension:ubyte = 2;
  // Original dimensions 1..4; unused components are zero.
  values:[Vec4] (required);
}
table Submesh { first_index:uint; index_count:uint; }
table Mesh {
  format_major:ushort; format_minor:ushort;
  name:string;
  positions:[Vec3] (required);
  normals:[Vec3];
  tangents:[Vec4]; colors:[Vec4]; texcoords:[TexCoord];
  indices:[uint] (required);
  submeshes:[Submesh] (required);
}
root_type Mesh;
file_identifier "NOMS";
file_extension "noms";
