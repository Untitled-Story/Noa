{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Noa particle-add-alpha shader recipe v1",
  "type": "object", "additionalProperties": false,
  "required": ["format", "version", "model", "revision", "program_sha256", "color_formula", "output_policy", "outputs", "source_outputs", "alpha_mode", "rgb_premultiply", "source_passes", "source_program_encoding", "source_program_hex"],
  "properties": {
    "format": {"const": "noa-shader-data"}, "version": {"const": 1},
    "model": {"const": "particle-add-alpha"}, "revision": {"const": 1},
    "program_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "color_formula": {"type": "string"}, "output_policy": {"const": "primary-color"},
    "outputs": {"const": [0]}, "source_outputs": {"const": [0, 1, 2]},
    "rgb_premultiply": {"const": true},
    "alpha_mode": {"type": "object", "additionalProperties": false,
      "required": ["stream", "component", "comparison", "threshold"],
      "properties": {"stream": {"const": 0}, "component": {"const": 0}, "comparison": {"const": "less_equal"}, "threshold": {"const": 0.5}}},
    "source_passes": {"type": "array"},
    "source_program_encoding": {"const": "unity-metal-lz4"},
    "source_program_hex": {"type": "string", "pattern": "^([0-9a-f]{2})+$"}
  }
}
